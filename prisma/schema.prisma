generator client {
  provider = "prisma-client-js"
}

// PostgreSQL for Vercel (Neon / Supabase). For local SQLite testing, change to "sqlite".
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Category {
  id        Int        @id @default(autoincrement())
  parentId  Int?       @map("parent_id")
  name      String
  slug      String     @unique
  image     String?
  sortOrder Int        @default(0) @map("sort_order")
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  parent    Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryToCategory")
  products  Product[]

  @@map("categories")
}

model Product {
  id                Int              @id @default(autoincrement())
  categoryId        Int?             @map("category_id")
  name              String
  slug              String           @unique
  team              String?
  season            String?
  kit               String?
  version           String?
  description       String?
  careNotes         String?          @map("care_notes")
  price             Int
  compareAtPrice    Int?             @map("compare_at_price")
  badge             String?
  isFeatured        Boolean          @default(false) @map("is_featured")
  isActive          Boolean          @default(true) @map("is_active")
  allowsPrinting    Boolean          @default(true) @map("allows_printing")
  allowsSleeveBadge Boolean          @default(false) @map("allows_sleeve_badge")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  category          Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images            ProductImage[]
  variants          ProductVariant[]
  orderItems        OrderItem[]

  @@index([team])
  @@map("products")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  path      String
  alt       String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductVariant {
  id         Int         @id @default(autoincrement())
  productId  Int         @map("product_id")
  size       String
  stock      Int         @default(0)
  reserved   Int         @default(0)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productId, size])
  @@map("product_variants")
}

model DeliveryZone {
  id        Int      @id @default(autoincrement())
  name      String
  method    String
  fee       Int      @default(0)
  freeOver  Int?     @map("free_over")
  estimate  String?
  note      String?
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders    Order[]

  @@map("delivery_zones")
}

model Order {
  id               Int           @id @default(autoincrement())
  number           String        @unique
  customerName     String        @map("customer_name")
  phone            String
  email            String?
  deliveryMethod   String        @map("delivery_method")
  deliveryZoneId   Int?          @map("delivery_zone_id")
  deliveryZoneName String?       @map("delivery_zone_name")
  address          String?
  notes            String?
  subtotal         Int
  deliveryFee      Int           @default(0) @map("delivery_fee")
  total            Int
  status           String        @default("pending_payment")
  expiresAt        DateTime?     @map("expires_at")
  paidAt           DateTime?     @map("paid_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  zone             DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  payments         Payment[]

  @@index([status])
  @@map("orders")
}

model OrderItem {
  id               Int             @id @default(autoincrement())
  orderId          Int             @map("order_id")
  productId        Int?            @map("product_id")
  productVariantId Int?            @map("product_variant_id")
  productName      String          @map("product_name")
  size             String
  unitPrice        Int             @map("unit_price")
  printName        String?         @map("print_name")
  printNumber      String?         @map("print_number")
  sleeveBadge      Boolean         @default(false) @map("sleeve_badge")
  printFee         Int             @default(0) @map("print_fee")
  quantity         Int
  lineTotal        Int             @map("line_total")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant          ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

model Payment {
  id                Int       @id @default(autoincrement())
  orderId           Int       @map("order_id")
  phone             String
  amount            Int
  merchantRequestId String?   @map("merchant_request_id")
  checkoutRequestId String?   @unique @map("checkout_request_id")
  status            String    @default("pending")
  mpesaReceipt      String?   @unique @map("mpesa_receipt")
  resultCode        Int?      @map("result_code")
  resultDesc        String?   @map("result_desc")
  callback          Json?
  paidAt            DateTime? @map("paid_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("payments")
}
